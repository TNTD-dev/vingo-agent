# Postgres: role vingo_agent chỉ có quyền trên schema agent
DATABASE_URL=postgresql+asyncpg://vingo_agent:vingo_agent@localhost:5432/vingo
BACKEND_URL=http://localhost:8080/api/v1

# Backend → agent (header X-Agent-Service-Key) và agent → backend (header X-Vingo-Agent-Key)
AGENT_SERVICE_KEY=replace-local-service-key
AGENT_TO_BACKEND_KEY=replace-local-agent-key

# Model: chuỗi model của PydanticAI "<provider>:<model>". Key theo biến chuẩn của provider.
# Model chính: GPT-6 Luna (PydanticAI gọi qua Responses API)
AGENT_MODEL=openai:gpt-6-luna
OPENAI_API_KEY=
# Model dự phòng khi model chính lỗi 5xx/timeout/429 trước chữ đầu tiên (V2.2 mục 2)
# DeepSeek V4.1 Flash: id API là deepseek-flash (DeepSeek không có id deepseek-v4.1)
AGENT_FALLBACK_MODEL=deepseek:deepseek-flash
DEEPSEEK_API_KEY=

# Giới hạn mỗi turn (V2.2 mục 2)
TURN_DEADLINE_S=120
MAX_MODEL_CALLS=20
MAX_TOOL_CALLS=40
MAX_INPUT_CHARS=4000
COMPACT_RATIO=0.8

# Kill switch: tên tool cách nhau dấu phẩy, ví dụ propose_hold_seats,confirm_pending_action
AGENT_DISABLED_TOOLS=
LOG_LEVEL=INFO
